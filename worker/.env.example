# Worker (runs on the GPU PC). Copy to worker/.env. Real environment variables win over this file.
# Fish Audio settings (FISH_API_KEY, FISH_VOICE_ID, FISH_TTS_MODEL, FISH_TTS_DIRECTION, FISH_TTS_SPEED)
# are read from the existing server's .env.local, so they are not repeated here.

APP_BASE_URL=https://your-app.vercel.app
# Create a worker token in the dashboard: Settings → Tokens.
WORKER_TOKEN=
WORKER_AGENT_ID=gpu-pc

# Existing Billions server checkout (its viewer/backend modules are imported, never modified).
# Empty = the "server" folder next to this repo. Empty values below also mean "use the default".
SERVER_DIR=
WORK_DIR=
REMOTION_DIR=

# 1 = no Fish Audio, Whisper, Openverse or ElevenLabs calls; placeholder audio instead.
DRY_RUN=

WHISPER_MODEL=small.en
WER_FLAG_THRESHOLD=0.25
POLL_INTERVAL_SEC=5
# While idle the poll interval grows to this (each poll is a Vercel function call).
POLL_MAX_INTERVAL_SEC=60
WORKER_CONCURRENCY=2
# Comma-separated subset of: voice,align,sfx,cards,thumbnail_compose,mix,render (empty = all).
WORKER_TYPES=
# 1 = keep the work folder of failed tasks for debugging.
KEEP_FAILED_WORK=

# ── Sound effects ────────────────────────────────────────────────────
# Openverse works without keys (about 1 request/second); OAuth client credentials raise the limit.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Freesound API commercial use needs a separate agreement with Freesound; enable only if you have one.
FREESOUND_ENABLED=
FREESOUND_API_KEY=
# ElevenLabs sound generation (paid plan required for commercial use).
ELEVENLABS_SFX_ENABLED=
ELEVENLABS_API_KEY=
# SQLite index built by: python -m slideshow_worker index-sfx <folder>
LOCAL_SFX_INDEX=
