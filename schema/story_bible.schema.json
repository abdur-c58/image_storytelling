{
  "$id": "https://slideshow-storytelling.local/schema/story_bible.schema.json",
  "title": "Story bible (schema 2.0)",
  "description": "One per story: channel, style, characters with outfits, locations with states/angles/props, world variables, voice/audio/render/crop defaults. Cross-field rules (unique ids, base states, enum values) are enforced by the site's validator; see docs/CLAUDE_SCRIPT_CONTRACT.md.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.0",
        "2.1"
      ]
    },
    "doc_type": {
      "type": "string",
      "const": "story_bible"
    },
    "story_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "story_title": {
      "type": "string",
      "minLength": 1
    },
    "total_episodes_planned": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "channel": {
      "type": "object",
      "properties": {
        "channel_name": {
          "type": "string",
          "minLength": 1
        },
        "recurring_cameo": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "rule": {
                  "default": "",
                  "type": "string"
                },
                "min_segments_per_episode": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "description"
              ],
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "channel_name"
      ],
      "additionalProperties": {}
    },
    "style_bible": {
      "type": "object",
      "properties": {
        "global_style_prompt": {
          "type": "string",
          "minLength": 1
        },
        "negative_prompt": {
          "default": "",
          "type": "string"
        },
        "aspect_ratio": {
          "default": "16:9",
          "type": "string",
          "const": "16:9"
        },
        "target_resolution": {
          "default": "1920x1080",
          "type": "string",
          "const": "1920x1080"
        },
        "source_image_min_width": {
          "default": 2560,
          "type": "integer",
          "minimum": 1280,
          "maximum": 8192
        },
        "palette_notes": {
          "default": "",
          "type": "string"
        },
        "reference_assets": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "description": {
                "default": "",
                "type": "string"
              },
              "asset_url_or_path": {
                "default": "",
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": {}
          }
        },
        "multi_character_negative": {
          "default": "merged faces, duplicate faces, fused bodies, extra limbs, the same face on two people, twins",
          "type": "string"
        },
        "flashback_treatment_prompt": {
          "default": "shown as a memory: faded warm sepia tint, soft hazy edges, gentle vignette",
          "type": "string"
        }
      },
      "required": [
        "global_style_prompt"
      ],
      "additionalProperties": {}
    },
    "narrator": {
      "default": {},
      "type": "object",
      "properties": {
        "pov": {
          "default": "second_person",
          "type": "string",
          "enum": [
            "second_person",
            "first_person",
            "third_person"
          ]
        },
        "pov_character_id": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "voice": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "voice_id": {
                  "default": "",
                  "type": "string"
                },
                "model": {
                  "default": "",
                  "type": "string"
                },
                "speed": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0.5,
                      "maximum": 2
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "gain_db": {
                  "default": 0,
                  "type": "number",
                  "minimum": -12,
                  "maximum": 12
                }
              },
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": {}
    },
    "characters": {
      "default": [],
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "story_outfit_states": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "description": {
                      "default": "",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": {}
                }
              },
              "first_appears_episode": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "initial_status": {
                "type": "string",
                "enum": [
                  "with_protagonist",
                  "separated",
                  "missing",
                  "captive",
                  "returned",
                  "unknown",
                  "deceased"
                ]
              },
              "role": {
                "type": "string",
                "enum": [
                  "protagonist",
                  "ally",
                  "antagonist",
                  "cameo",
                  "extra"
                ]
              }
            },
            "required": [
              "ref"
            ],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "default": "extra",
                "type": "string",
                "enum": [
                  "protagonist",
                  "ally",
                  "antagonist",
                  "cameo",
                  "extra"
                ]
              },
              "scope": {
                "default": "story",
                "type": "string",
                "enum": [
                  "story",
                  "channel"
                ]
              },
              "visual_description": {
                "type": "string",
                "minLength": 1
              },
              "outfit_states": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "description": {
                      "default": "",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": {}
                }
              },
              "reference_image_ids": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                }
              },
              "first_appears_episode": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "voice": {
                "default": null,
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "default": "fish_audio",
                        "type": "string",
                        "const": "fish_audio"
                      },
                      "voice_id": {
                        "default": "",
                        "type": "string"
                      },
                      "model": {
                        "default": "",
                        "type": "string"
                      },
                      "speed": {
                        "default": 1,
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 2
                      },
                      "gain_db": {
                        "default": 0,
                        "type": "number",
                        "minimum": -12,
                        "maximum": 12
                      },
                      "style_notes": {
                        "default": "",
                        "type": "string",
                        "maxLength": 120
                      },
                      "pronunciation_overrides": {
                        "default": {},
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "minLength": 1
                        },
                        "additionalProperties": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "additionalProperties": {}
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "voice_group": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "initial_status": {
                "default": "with_protagonist",
                "type": "string",
                "enum": [
                  "with_protagonist",
                  "separated",
                  "missing",
                  "captive",
                  "returned",
                  "unknown",
                  "deceased"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "visual_description"
            ],
            "additionalProperties": {}
          }
        ]
      }
    },
    "character_groups": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "character_ids": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            }
          },
          "description": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "id",
          "character_ids"
        ],
        "additionalProperties": {}
      }
    },
    "scene_bible": {
      "default": {},
      "type": "object",
      "properties": {
        "world_variables": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "integer",
                  "number",
                  "string",
                  "enum"
                ]
              },
              "initial": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "values": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "prompt_template": {
                "default": "",
                "type": "string"
              },
              "applies_to_location_tags": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "monotonic": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "increasing",
                      "decreasing"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "max_step_per_segment": {
                "default": null,
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "type",
              "initial"
            ],
            "additionalProperties": {}
          }
        },
        "locations": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "tags": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "anchor_description": {
                "type": "string",
                "minLength": 1
              },
              "fixed_landmarks": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "camera_angles": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "name": {
                      "default": "",
                      "type": "string"
                    },
                    "prompt": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "prompt"
                  ],
                  "additionalProperties": {}
                }
              },
              "states": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "description": {
                      "default": "",
                      "type": "string"
                    },
                    "is_base": {
                      "default": false,
                      "type": "boolean"
                    },
                    "derived_from": {
                      "default": null,
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64,
                          "pattern": "^[a-z0-9][a-z0-9_-]*$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": {}
                }
              },
              "key_props": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "default_position": {
                      "default": "",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "description"
                  ],
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "id",
              "name",
              "anchor_description",
              "camera_angles",
              "states"
            ],
            "additionalProperties": {}
          }
        }
      },
      "additionalProperties": {}
    },
    "defaults": {
      "default": {},
      "type": "object",
      "properties": {
        "voice": {
          "default": {},
          "type": "object",
          "properties": {
            "provider": {
              "default": "fish_audio",
              "type": "string",
              "const": "fish_audio"
            },
            "voice_id": {
              "default": "",
              "type": "string"
            },
            "model": {
              "default": "",
              "type": "string"
            },
            "speed": {
              "default": 1,
              "type": "number",
              "minimum": 0.5,
              "maximum": 2
            },
            "style_notes": {
              "default": "",
              "type": "string",
              "maxLength": 120
            },
            "pronunciation_overrides": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "tag_whitelist": {
              "default": [
                "short pause",
                "pause",
                "long pause",
                "break",
                "long-break",
                "breath",
                "sigh",
                "laugh",
                "shaky breath"
              ],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "paired_tags": {
              "default": [
                "whisper",
                "emphasis",
                "soft",
                "fast",
                "slow",
                "stress",
                "forceful"
              ],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "unknown_tag_level": {
              "default": "warning",
              "type": "string",
              "enum": [
                "warning",
                "error"
              ]
            },
            "max_tags_per_100_words": {
              "default": 8,
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "pause_between_sentences_ms": {
              "default": 350,
              "type": "integer",
              "minimum": 0,
              "maximum": 5000
            },
            "pause_between_segments_ms": {
              "default": 450,
              "type": "integer",
              "minimum": 0,
              "maximum": 5000
            },
            "narrator_to_dialogue_gap_ms": {
              "default": 350,
              "type": "integer",
              "minimum": 0,
              "maximum": 5000
            },
            "dialogue_reply_gap_ms": {
              "default": 220,
              "type": "integer",
              "minimum": 0,
              "maximum": 5000
            },
            "tag_fallback_mode": {
              "default": "split_and_silence",
              "type": "string",
              "enum": [
                "split_and_silence",
                "none"
              ]
            },
            "pause_durations_ms": {
              "default": {
                "short pause": 400,
                "pause": 700,
                "long pause": 1200,
                "break": 400,
                "long-break": 1200
              },
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            }
          },
          "additionalProperties": {}
        },
        "audio": {
          "default": {},
          "type": "object",
          "properties": {
            "master_loudness_lufs": {
              "default": -14,
              "type": "number",
              "minimum": -30,
              "maximum": -8
            },
            "true_peak_db": {
              "default": -1.5,
              "type": "number",
              "minimum": -9,
              "maximum": 0
            },
            "voice_target_lufs": {
              "default": -16,
              "type": "number",
              "minimum": -30,
              "maximum": -10
            },
            "sfx_default_gain_db": {
              "default": -18,
              "type": "number",
              "minimum": -60,
              "maximum": 6
            },
            "music": {
              "default": {},
              "type": "object",
              "properties": {
                "enabled": {
                  "default": false,
                  "type": "boolean"
                },
                "query": {
                  "default": "",
                  "type": "string"
                },
                "gain_db": {
                  "default": -26,
                  "type": "number",
                  "minimum": -60,
                  "maximum": 0
                },
                "duck_under_voice": {
                  "default": true,
                  "type": "boolean"
                }
              },
              "additionalProperties": {}
            }
          },
          "additionalProperties": {}
        },
        "render": {
          "default": {},
          "type": "object",
          "properties": {
            "resolution": {
              "default": "1920x1080",
              "type": "string",
              "const": "1920x1080"
            },
            "fps": {
              "default": 30,
              "anyOf": [
                {
                  "type": "number",
                  "const": 24
                },
                {
                  "type": "number",
                  "const": 25
                },
                {
                  "type": "number",
                  "const": 30
                },
                {
                  "type": "number",
                  "const": 60
                }
              ]
            },
            "burn_in_captions": {
              "default": false,
