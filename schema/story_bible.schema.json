        "crop_policy": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "max_crop": {
              "default": 0.2,
              "type": "number",
              "minimum": 0,
              "maximum": 0.2
            },
            "typical_max_crop": {
              "default": 0.1,
              "type": "number",
              "minimum": 0,
              "maximum": 0.2
            },
            "min_crop": {
              "default": 0.04,
              "type": "number",
              "minimum": 0,
              "maximum": 0.2
            },
            "prob_typical": {
              "default": 0.85,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "crop_measure": {
