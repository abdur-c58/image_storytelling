            "crf": {
              "default": 18,
              "type": "integer",
              "minimum": 10,
              "maximum": 35
            },
            "audio_bitrate_kbps": {
              "default": 192,
              "anyOf": [
                {
                  "type": "number",
                  "const": 128
                },
                {
                  "type": "number",
                  "const": 192
                },
                {
                  "type": "number",
                  "const": 256
                },
                {
                  "type": "number",
                  "const": 320
                }
              ]
            }
