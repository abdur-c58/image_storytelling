          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "description": {
                "default": "",
                "type": "string"
              },
              "asset_url_or_path": {
                "default": "",
                "type": "string"
              }
