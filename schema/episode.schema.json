                  "prompt": {
                    "default": "",
                    "type": "string"
                  },
                  "characters_present": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    }
                  },
                  "shot_type": {
                    "default": "",
                    "type": "string"
                  },
                  "mood": {
                    "default": "",
                    "type": "string"
                  },
                  "time_of_day": {
                    "default": "",
                    "type": "string"
                  },
                  "negative_prompt_extra": {
                    "default": "",
                    "type": "string"
                  },
                  "reuse_from_segment_id": {
                    "default": null,
