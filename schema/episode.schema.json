                      },
                      "subtitle": {
                        "default": null,
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "body": {
                        "default": null,
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "background": {
                        "default": "dark",
                        "type": "string",
                        "enum": [
                          "dark",
                          "cream",
                          "image"
                        ]
                      },
                      "background_image_segment_id": {
                        "default": null,
