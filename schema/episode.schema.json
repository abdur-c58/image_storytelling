                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64,
                            "pattern": "^[a-z0-9][a-z0-9_-]*$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "items": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "default": "",
                              "type": "string"
                            },
                            "value": {
                              "default": null,
                              "type": [
                                "string",
                                "number",
                                "null"
                              ]
                            },
                            "icon": {
                              "default": "",
                              "type": "string"
                            },
                            "icon_count": {
                              "default": null,
                              "anyOf": [
                                {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 100
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "icon_total": {
                              "default": null,
                              "anyOf": [
                                {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 100
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "additionalProperties": {}
                        }
                      },
                      "footer": {
                        "default": null,
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "accent": {
                        "default": "red",
                        "type": "string",
                        "enum": [
                          "red",
                          "blue",
                          "none"
                        ]
                      }
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "template"
                ],
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          },
          "sfx": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "search_query": {
                  "type": "string",
                  "minLength": 1
                },
                "alt_queries": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "must_include_tags": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "exclude_tags": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "placement": {
                  "default": "segment_start",
                  "type": "string",
                  "enum": [
                    "segment_start",
                    "segment_end",
                    "at_phrase",
                    "whole_segment"
                  ]
                },
                "at_phrase": {
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "offset_sec": {
                  "default": 0,
                  "type": "number",
                  "minimum": -30,
                  "maximum": 120
                },
                "duration_sec": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 600
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "loop": {
                  "default": false,
                  "type": "boolean"
                },
                "gain_db": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -60,
                      "maximum": 12
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "fade_in_ms": {
                  "default": 100,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
