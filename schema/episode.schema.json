        "music": {
          "default": {
            "enabled": false,
            "query": "",
            "gain_db": -26,
            "duck_under_voice": true
          },
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "query": {
              "default": "",
              "type": "string"
            },
            "gain_db": {
              "default": -26,
              "type": "number",
              "minimum": -60,
              "maximum": 0
            },
            "duck_under_voice": {
              "default": true,
              "type": "boolean"
            }
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": {}
