      "type": "object",
      "properties": {
        "series_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "series_title": {
          "type": "string",
          "minLength": 1
        },
        "episode_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "total_episodes_planned": {
          "default": null,
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "episode_title_short": {
          "type": "string",
          "minLength": 1
        },
        "recap_of_previous": {
          "default": "",
          "type": "string"
        },
        "cliffhanger": {
          "default": "",
          "type": "string"
        },
        "next_episode_teaser": {
          "default": "",
          "type": "string"
        },
        "state_carryover": {
          "default": {
            "day_counter_end": null,
            "resources": {},
            "characters_status": {}
          },
          "type": "object",
          "properties": {
            "day_counter_end": {
              "default": null,
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "resources": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "characters_status": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "series_id",
        "series_title",
        "episode_number",
        "episode_title_short"
      ],
      "additionalProperties": {}
    },
    "style_bible": {
      "type": "object",
