        "voice_target_lufs": {
          "default": -16,
          "type": "number",
          "minimum": -30,
          "maximum": -10
        },
        "sfx_default_gain_db": {
          "default": -18,
          "type": "number",
          "minimum": -60,
          "maximum": 6
