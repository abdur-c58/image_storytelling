                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[a-z0-9][a-z0-9_-]*$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "motion": {
                    "default": "none",
                    "type": "string",
                    "enum": [
                      "none",
                      "slow_zoom_in",
                      "slow_zoom_out",
                      "pan_left",
                      "pan_right"
                    ]
                  }
                },
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          },
          "remotion": {
            "default": null,
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "template": {
                    "type": "string",
                    "enum": [
                      "title_card",
                      "supplies_card",
                      "pictogram_chart",
                      "statement_card",
                      "lower_third",
                      "custom"
                    ]
                  },
                  "props": {
                    "default": {
                      "title": null,
                      "subtitle": null,
                      "body": null,
                      "background": "dark",
                      "background_image_segment_id": null,
                      "items": [],
                      "footer": null,
                      "accent": "red"
                    },
                    "type": "object",
                    "properties": {
                      "title": {
                        "default": null,
                        "type": [
                          "string",
                          "null"
