            "required": [
              "id"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "global_style_prompt"
      ],
      "additionalProperties": {}
    },
    "voice": {
      "default": {
        "provider": "fish_audio",
        "voice_id": "",
        "model": "",
        "speed": 1,
        "style_notes": "",
        "pronunciation_overrides": {},
        "pause_between_segments_ms": 250
