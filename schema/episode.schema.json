      "properties": {
        "provider": {
          "default": "fish_audio",
          "type": "string",
          "const": "fish_audio"
        },
        "voice_id": {
          "default": "",
          "type": "string"
        },
        "model": {
          "default": "",
          "type": "string"
        },
        "speed": {
          "default": 1,
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "style_notes": {
          "default": "",
          "type": "string",
          "maxLength": 120
        },
        "pronunciation_overrides": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "pause_between_segments_ms": {
          "default": 250,
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        }
      },
      "additionalProperties": {}
    },
    "audio": {
      "default": {
        "master_loudness_lufs": -14,
        "true_peak_db": -1.5,
        "voice_target_lufs": -16,
        "sfx_default_gain_db": -18,
        "music": {
          "enabled": false,
          "query": "",
          "gain_db": -26,
          "duck_under_voice": true
        }
      },
      "type": "object",
      "properties": {
        "master_loudness_lufs": {
          "default": -14,
          "type": "number",
          "minimum": -30,
          "maximum": -8
