# Website (Next.js on Vercel). Copy to .env.local for local development; set the same names in
# Vercel → Project → Settings → Environment Variables for production.

# ── Database ─────────────────────────────────────────────────────────
# Supabase: use the transaction pooler URL (port 6543) for the site.
#   postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Leave empty locally to use an embedded PGlite database in .data/pglite.
DATABASE_URL=
DATABASE_POOL_MAX=5
# 1 = run Drizzle migrations on first request (fine for one deployment; or run `npm run db:migrate`).
AUTO_MIGRATE=1

# ── Storage ──────────────────────────────────────────────────────────
# r2 when R2_BUCKET_NAME is set, otherwise local (.data/storage, development only).
STORAGE_DRIVER=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Everything this project writes lives under this folder of the shared bucket.
STORAGE_PREFIX=slideshow-storytelling/
LOCAL_STORAGE_DIR=.data/storage
SIGNED_URL_TTL_SEC=21600

# ── Auth ─────────────────────────────────────────────────────────────
# Long random string; signs session cookies and local-storage URLs. Required in production.
SESSION_SECRET=
# Dashboard password. Empty = dashboard open in development only.
ADMIN_PASSWORD=
# Public URL of the site, used in links handed to the bot and worker.
APP_BASE_URL=https://your-app.vercel.app
# Optional bootstrap tokens (prefer creating hashed tokens in Settings, then remove these).
BOT_TOKEN=
WORKER_TOKEN=
# Vercel Cron sends this as a bearer token to /api/cron/maintenance.
CRON_SECRET=

# ── Pipeline ─────────────────────────────────────────────────────────
BOT_LEASE_SEC=600
WORKER_LEASE_SEC=300
MAX_IMAGE_ATTEMPTS=3
# Days after publishing before voice/sfx/mix/timeline/card intermediates are deleted.
INTERMEDIATE_RETENTION_DAYS=14
# 1 = show a DRY RUN badge (pair with DRY_RUN=1 on the worker).
DRY_RUN=
